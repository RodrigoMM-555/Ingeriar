# Archivos subidos desde la aplicación: pueden contener datos reales de personas
# (fotos, facturas, entregas). Nunca se suben al repositorio, que es público.
storage/galeria/*
!storage/galeria/.gitkeep
storage/facturas/*
!storage/facturas/.gitkeep
storage/configuracion/*
!storage/configuracion/.gitkeep
storage/inventario/*
!storage/inventario/.gitkeep
storage/documentos/*
!storage/documentos/.gitkeep
!storage/documentos/biblioteca/
# Plantillas que sube el administrador (E-14): no se versionan (cada grupo tiene las suyas).
storage/documentos/biblioteca/*
!storage/documentos/biblioteca/.gitkeep
# Copias de seguridad (E-12): contienen datos de menores, nunca van al repositorio.
copias/*
!copias/.htaccess
